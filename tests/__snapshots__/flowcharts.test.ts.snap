exports[`flowchart SVG regressions > matches the approved SVG for flowcharts/test_flowchart2.mmd 1`] = `"<svg id=\\"mermaid-test-test_flowchart2-mmd\\" width=\\"100%\\" xmlns=\\"http://www.w3.org/2000/svg\\" class=\\"flowchart\\" style=\\"max-width: 86992px;\\" viewBox=\\"-8 -8 86992 36\\" role=\\"graphics-document document\\" aria-roledescription=\\"flowchart-elk\\"><style>#mermaid-test-test_flowchart2-mmd{font-family:\\"trebuchet ms\\",verdana,arial,sans-serif;font-size:16px;fill:#333;}@keyframes edge-animation-frame{from{stroke-dashoffset:0;}}@keyframes dash{to{stroke-dashoffset:0;}}#mermaid-test-test_flowchart2-mmd .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 50s linear infinite;stroke-linecap:round;}#mermaid-test-test_flowchart2-mmd .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 20s linear infinite;stroke-linecap:round;}#mermaid-test-test_flowchart2-mmd .error-icon{fill:#552222;}#mermaid-test-test_flowchart2-mmd .error-text{fill:#552222;stroke:#552222;}#mermaid-test-test_flowchart2-mmd .edge-thickness-normal{stroke-width:1px;}#mermaid-test-test_flowchart2-mmd .edge-thickness-thick{stroke-width:3.5px;}#mermaid-test-test_flowchart2-mmd .edge-pattern-solid{stroke-dasharray:0;}#mermaid-test-test_flowchart2-mmd .edge-thickness-invisible{stroke-width:0;fill:none;}#mermaid-test-test_flowchart2-mmd .edge-pattern-dashed{stroke-dasharray:3;}#mermaid-test-test_flowchart2-mmd .edge-pattern-dotted{stroke-dasharray:2;}#mermaid-test-test_flowchart2-mmd .marker{fill:#333333;stroke:#333333;}#mermaid-test-test_flowchart2-mmd .marker.cross{stroke:#333333;}#mermaid-test-test_flowchart2-mmd svg{font-family:\\"trebuchet ms\\",verdana,arial,sans-serif;font-size:16px;}#mermaid-test-test_flowchart2-mmd p{margin:0;}#mermaid-test-test_flowchart2-mmd .label{font-family:\\"trebuchet ms\\",verdana,arial,sans-serif;color:#333;}#mermaid-test-test_flowchart2-mmd .cluster-label text{fill:#333;}#mermaid-test-test_flowchart2-mmd .cluster-label span{color:#333;}#mermaid-test-test_flowchart2-mmd .cluster-label span p{background-color:transparent;}#mermaid-test-test_flowchart2-mmd .label text,#mermaid-test-test_flowchart2-mmd span{fill:#333;color:#333;}#mermaid-test-test_flowchart2-mmd .node rect,#mermaid-test-test_flowchart2-mmd .node circle,#mermaid-test-test_flowchart2-mmd .node ellipse,#mermaid-test-test_flowchart2-mmd .node polygon,#mermaid-test-test_flowchart2-mmd .node path{fill:#ECECFF;stroke:#9370DB;stroke-width:1px;}#mermaid-test-test_flowchart2-mmd .rough-node .label text,#mermaid-test-test_flowchart2-mmd .node .label text,#mermaid-test-test_flowchart2-mmd .image-shape .label,#mermaid-test-test_flowchart2-mmd .icon-shape .label{text-anchor:middle;}#mermaid-test-test_flowchart2-mmd .node .katex path{fill:#000;stroke:#000;stroke-width:1px;}#mermaid-test-test_flowchart2-mmd .rough-node .label,#mermaid-test-test_flowchart2-mmd .node .label,#mermaid-test-test_flowchart2-mmd .image-shape .label,#mermaid-test-test_flowchart2-mmd .icon-shape .label{text-align:center;}#mermaid-test-test_flowchart2-mmd .node.clickable{cursor:pointer;}#mermaid-test-test_flowchart2-mmd .root .anchor path{fill:#333333!important;stroke-width:0;stroke:#333333;}#mermaid-test-test_flowchart2-mmd .arrowheadPath{fill:#333333;}#mermaid-test-test_flowchart2-mmd .edgePaths .path{stroke:#333333;stroke-width:1px;}#mermaid-test-test_flowchart2-mmd .flowchart-link{stroke:#333333;fill:none;}#mermaid-test-test_flowchart2-mmd .edgeLabel{background-color:rgba(232,232,232, 0.8);text-align:center;}#mermaid-test-test_flowchart2-mmd .edgeLabel p{background-color:rgba(232,232,232, 0.8);}#mermaid-test-test_flowchart2-mmd .edgeLabel rect{opacity:0.5;background-color:rgba(232,232,232, 0.8);fill:rgba(232,232,232, 0.8);}#mermaid-test-test_flowchart2-mmd .labelBkg{background-color:rgba(232, 232, 232, 0.5);}#mermaid-test-test_flowchart2-mmd .cluster rect{fill:#ffffde;stroke:#aaaa33;stroke-width:1px;}#mermaid-test-test_flow