exports[`flowchart SVG regressions > matches the approved SVG for flowcharts/test_flowchart4.mmd 1`] = `"<svg id=\\"mermaid-test-test_flowchart4-mmd\\" width=\\"100%\\" xmlns=\\"http://www.w3.org/2000/svg\\" class=\\"flowchart\\" style=\\"max-width: 95800px;\\" viewBox=\\"-8 -8 95800 36\\" role=\\"graphics-document document\\" aria-roledescription=\\"flowchart-elk\\"><style>#mermaid-test-test_flowchart4-mmd{font-family:\\"trebuchet ms\\",verdana,arial,sans-serif;font-size:16px;fill:#333;}@keyframes edge-animation-frame{from{stroke-dashoffset:0;}}@keyframes dash{to{stroke-dashoffset:0;}}#mermaid-test-test_flowchart4-mmd .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 50s linear infinite;stroke-linecap:round;}#mermaid-test-test_flowchart4-mmd .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 20s linear infinite;stroke-linecap:round;}#mermaid-test-test_flowchart4-mmd .error-icon{fill:#552222;}#mermaid-test-test_flowchart4-mmd .error-text{fill:#552222;stroke:#552222;}#mermaid-test-test_flowchart4-mmd .edge-thickness-normal{stroke-width:1px;}#mermaid-test-test_flowchart4-mmd .edge-thickness-thick{stroke-width:3.5px;}#mermaid-test-test_flowchart4-mmd .edge-pattern-solid{stroke-dasharray:0;}#mermaid-test-test_flowchart4-mmd .edge-thickness-invisible{stroke-width:0;fill:none;}#mermaid-test-test_flowchart4-mmd .edge-pattern-dashed{stroke-dasharray:3;}#mermaid-test-test_flowchart4-mmd .edge-pattern-dotted{stroke-dasharray:2;}#mermaid-test-test_flowchart4-mmd .marker{fill:#333333;stroke:#333333;}#mermaid-test-test_flowchart4-mmd .marker.cross{stroke:#333333;}#mermaid-test-test_flowchart4-mmd svg{font-family:\\"trebuchet ms\\",verdana,arial,sans-serif;font-size:16px;}#mermaid-test-test_flowchart4-mmd p{margin:0;}#mermaid-test-test_flowchart4-mmd .label{font-family:\\"trebuchet ms\\",verdana,arial,sans-serif;color:#333;}#mermaid-test-test_flowchart4-mmd .cluster-label text{fill:#333;}#mermaid-test-te