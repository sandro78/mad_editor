exports[`flowchart SVG regressions > matches the approved SVG for flowcharts/test_flowchart3.mmd 1`] = `"<svg id=\\"mermaid-test-test_flowchart3-mmd\\" width=\\"100%\\" xmlns=\\"http://www.w3.org/2000/svg\\" class=\\"flowchart\\" style=\\"max-width: 87896px;\\" viewBox=\\"-8 -8 87896 36\\" role=\\"graphics-document document\\" aria-roledescription=\\"flowchart-elk\\"><style>#mermaid-test-test_flowchart3-mmd{font-family:\\"trebuchet ms\\",verdana,arial,sans-serif;font-size:16px;fill:#333;}@keyframes edge-animation-frame{from{stroke-dashoffset:0;}}@keyframes dash{to{stroke-dashoffset:0;}}#mermaid-test-test_flowchart3-mmd .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 50s linear infinite;stroke-linecap:round;}#mermaid-test-test_flowchart3-mmd .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 20s linear infinite;stroke-linecap:round;}#mermaid-test-test_flowchart3-mmd .error-icon{fill:#552222;}#mermaid-test-test_flowchart3-mmd .error-text{fill:#552222;stroke:#552222;}#mermaid-test-test_flowchart3-mmd .edge-thickness-normal{stroke-width:1px;}#mermaid-test-test_flowchart3-mmd .edge-thickness-thick{stroke-width:3.5px;}#mermaid-test-test_flowchart3-mmd .edge-pattern-solid{stroke-dasharray:0;}#mermaid-test-test_flowchart3-mmd .edge-thickness-invisible{stroke-width:0;fill:none;}#mermaid-test-test_flowchart3-mmd .edge-pattern-dashed{stroke-dasharray:3;}#mermaid-test-test_flowchart3-mmd .edge-pattern-dotted{stroke-dasharray:2;}#mermaid-test-test_flowchart3-mmd .marker{fill:#333333;stroke:#333333;}#mermaid-test-test_flowchart3-mmd .marker.cross{stroke:#333333;}#mermaid-test-test_flowchart3-mmd svg{font-family:\\"trebuchet ms\\",verdana,arial,sans-serif;font-size:16px;}#mermaid-test-test_flowchart3-mmd p{margin:0;}#mermaid-test-test_flowchart3-mmd .label{font-family:\\"trebuchet ms\\",verdana,arial,sans-serif;color:#333;}#mermaid-test-test_flowchart3-mmd .cluster-label text{fill:#333;}#mermaid-test-test_flowchart3-mmd .cluster-label span{color:#333;}#mermaid-test-test_flowchart3-mmd .cluster-label span p{background-color:transparent;}#mermaid-test-test_flowchart3-mmd .label text,#mermaid-test-test_flowchart3-mmd span{fill:#333;color:#333;}#mermaid-test-test_flowchart3-mmd .node rect,#mermaid-test-test_flowchart3-mmd .node circle,#mermaid-test-test_flowchart3-mmd .node ellipse,#mermaid-test-test_flowchart3-mmd .node polygon,#mermaid-test-test_flowchart3-mmd .node path{fill:#ECECFF;stroke:#9370DB;stroke-width:1px;}#mermaid-test-test_flowchart3-mmd .rough-node .label text,#mermaid-test-test_flowchart3-mmd .node .label text,#mermaid-test-test_flowchart3-mmd .image-shape .label,#mermaid-test-test_flowchart3-mmd .icon-shape .label{text-anchor:middle;}#mermaid-test-test_flowchart3-mmd .node .katex path{fill:#000;stroke:#000;stroke-width:1px;}#mermaid-test-test_flowchart3-mmd .rough-node .label,#mermaid-test-test_flowchart3-mmd .node .label,#mermaid-test-test_flowchart3-mmd .image-shape .label,#mermaid-test-test_flowchart3-mmd .icon-shape .label{text-align:center;}#mermaid-test-test_flowchart3-mmd .node.clickable{cursor:pointer;}#mermaid-test-test_flowchart3-mmd .root .anchor path{fill:#333333!important;stroke-width:0;stroke:#333333;}#mermaid-test-test_flowchart3-mmd .arrowheadPath{fill:#333333;}#mermaid-test-test_flowchart3-mmd .edgePaths .path{stroke:#333333;stroke-width:1px;}#mermaid-test-test_flowchart3-mmd .flowchart-link{stroke:#333333;fill:none;}#mermaid-test-test_flowchart3-mmd .edgeLabel{background-color:rgba(232,232,232, 0.8);text-align:center;}#mermaid-test-test_flowchart3-mmd .edgeLabel p{background-color:rgba(232,232,232, 0.8);}#mermaid-test-test_flowchart3-mmd .edgeLabel rect{opacity:0.5;background-color:rgba(232,232,232, 0.8);fill:rgba(232,232,232, 0.8);}#mermaid-test-test_flowchart3-mmd .labelBkg{background-color:rgba(232, 232, 232, 0.5);}#mermaid-test-test_flowchart3-mmd .cluster rect{fill:#ffffde;stroke:#aaaa33;stroke-width:1px;}#mermaid-test-test_flowchart3-mmd .cluster text{fill:#333;}#mermaid-test-test_flowchart3-mmd .cluster span{color:#333;}#mermaid-test-test_flowchart3-mmd .node .collapsed-indicator{fill:#aaaa33;stroke:none;opacity:0.6;}#mermaid-test-test_flowchart3-mmd .node .collapsed-separator{stroke:#aaaa33;stroke-width:0.75px;}#mermaid-test-test_flowchart3-mmd div.mermaidTooltip{position:absolute;text-align:center;max-width:200px;padding:2px;font-family:\\"trebuchet ms\\",verdana,arial,sans-serif;font-size:12px;background:hsl(80, 100%, 96.2745098039%);border:1px solid #aaaa33;border-radius:2px;pointer-events:none;z-index:100;}#mermaid-test-test_flowchart3-mmd .flowchartTitleText{text-anchor:middle;font-size:18px;fill:#333;}#mermaid-test-test_flowchart3-mmd rect.text{fill:none;stroke-width:0;}#mermaid-test-test_flowchart3-mmd .icon-shape,#mermaid-test-test_flowchart3-mmd .image-shape{background-color:rgba(232,232,232, 0.8);text-align:center;}#mermaid-test-test_flowchart3-mmd .icon-shape p,#mermaid-test-test_flowchart3-mmd .image-shape p{background-color:rgba(232,232,232, 0.8);padding:2px;}#mermaid-test-test_flowchart3-mmd .icon-shape .label rect,#mermaid-test-test_flowchart3-mmd .image-shape .label rect{opacity:0.5;background-color:rgba(232,232,232, 0.8);fill:rgba(232,232,232, 0.8);}#mermaid-test-test_flowchart3-mmd .label-icon{display:inline-block;height:1em;overflow:visible;vertical-align:-0.125em;}#mermaid-test-test_flowchart3-mmd .node .label-icon path{fill:currentColor;stroke:revert;stroke-width:revert;}#mermaid-test-test_flowchart3-mmd .node .neo-node{stroke:#9370DB;}#mermaid-test-test_flowchart3-mmd [data-look=\\"neo\\"].node rect,#mermaid-test-test_flowchart3-mmd [data-look=\\"neo\\"].cluster rect,#mermaid-test-test_flowchart3-mmd [data-look=\\"neo\\"].node polygon{stroke:#9370DB;filter:drop-shadow(1px 2px 2px rgba(185, 185, 185, 1));}#mermaid-test-test_flowchart3-mmd [data-look=\\"neo\\"].swimlane.cluster rect{filter:none;}#mermaid-test-test_flowchart3-mmd [data-look=\\"neo\\"].node path{stroke:#9370DB;stroke-width:1px;}#mermaid-test-test_flowchart3-mmd [data-look=\\"neo\\"].node .outer-path{filter:drop-shadow(1px 2px 2px rgba(185, 185, 185, 1));}#mermaid-test-test_flowchart3-mmd [data-look=\\"neo\\"].node .neo-line path{stroke:#9370DB;filter:none;}#mermaid-test-test_flowchart3-mmd [data-look=\\"neo\\"].node circle{stroke:#9370DB;filter:drop-shadow(1px 2px 2px rgba(185, 185, 185, 1));}#mermaid-test-test_flowchart3-mmd [data-look=\\"neo\\"].node circle .state-start{fill:#000000;}#mermaid-test-test_flowchart3-mmd [data-look=\\"neo\\"].icon-shape .icon{fill:#9370DB;filter:drop-shadow(1px 2px 2px rgba(185, 185, 185, 1));}#mermaid-test-test_flowchart3-mmd [data-look=\\"neo\\"].icon-shape .icon-neo path{stroke:#9370DB;filter:drop-shadow(1px 2px 2px rgba(185, 185, 185, 1));}#mermaid-test-test_flowchart3-mmd :root{--mermaid-font-family:\\"trebuchet ms\\",verdana,arial,sans-serif;}#mermaid-test-test_flowchart3-mmd .client rect{fill:#4F81BD!important;stroke:#2F5597!important;color:#fff!important;stroke-width:2px!important;}#mermaid-test-test_flowchart3-mmd .client polygon{fill:#4F81BD!important;stroke:#2F5597!important;color:#fff!important;stroke-width:2px!important;}#mermaid-test-test_flowchart3-mmd .client ellipse{fill:#4F81BD!important;stroke:#2F5597!important;color:#fff!important;stroke-width:2px!important;}#mermaid-test-test_flowchart3-mmd .client circle{fill:#4F81BD!important;stroke:#2F5597!important;color:#fff!important;stroke-width:2px!important;}#mermaid-test-test_flowchart3-mmd .client path{fill:#4F81BD!important;stroke:#2F5597!important;color:#fff!important;stroke-width:2px!important;}#mermaid-test-test_flowchart3-mmd .client tspan{fill:#fff!important;}#mermaid-test-test_flowchart3-mmd .agent rect{fill:#ED7D31!important;stroke:#C65911!important;color:#fff!important;stroke-width:3px!important;}#mermaid-test-test_flowchart3-mmd .agent polygon{fill:#ED7D31!important;stroke:#C65911!important;color:#fff!important;stroke-width:3px!important;}#mermaid-test-test