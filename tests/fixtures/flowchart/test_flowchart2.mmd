flowchart TB
  subgraph UI["Management panel"]
    PUI["Calls Agent API"]
  end
  subgraph API["Agent — Volume Management API"]
    REST["REST API"]
    GET_LIST["Get volumes list"]
    GET_ONE["Get specific volume info"]
    CREATE["Create volume"]
    DELETE["Delete volume"]
    UPDATE["Change volume's parameters"]
  end
  subgraph LOGIC["Agent — volumes management logic"]
    HANDLER["API handlers"]
    CLI["storage CLI"]
    FS["Work with service mount<br/>points of storage at FS"]
  end
  subgraph STORAGE["Storage cluster"]
    VCLI["Storage CLI management commands"]
    MOUNT["Service mount points"]
    VOLUMES[("Cluster volumes")]
  end
  PUI --> REST
  REST --> GET_LIST & GET_ONE & CREATE & DELETE & UPDATE
  GET_LIST --> HANDLER
  GET_ONE --> HANDLER
  CREATE --> HANDLER
  DELETE --> HANDLER
  UPDATE --> HANDLER
  HANDLER --> CLI
  HANDLER --> FS
  CLI <--> VCLI
  FS <--> MOUNT
  VCLI --> VOLUMES
  MOUNT <--> VOLUMES

